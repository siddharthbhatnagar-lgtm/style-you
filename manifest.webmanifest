{
  "id": "./",
  "name": "Style You",
  "short_name": "Style You",
  "description": "Outfits from your own wardrobe every day, and full looks for occasions — styled by your own Gemini or ChatGPT.",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F2F2F7",
  "theme_color": "#4B48C9",
  "lang": "en-IN",
  "categories": [
    "lifestyle",
    "shopping"
  ],
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Today",
      "url": "./#/home",
      "icons": [
        {
          "src": "sc-today.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Style me for an occasion",
      "short_name": "Occasion",
      "url": "./#/session/new",
      "icons": [
        {
          "src": "sc-occasion.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Mix & Match",
      "url": "./#/mix",
      "icons": [
        {
          "src": "sc-mix.png",
          "sizes": "96x96",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*"
          ]
        }
      ]
    }
  }
}